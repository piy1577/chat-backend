generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


model message {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  text   String
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("messages")
}